{
	"$schema": "https://turbo.build/schema.json",
	"tasks": {
		"build": {"dependsOn": ["^build"], "outputs": ["dist/**", "README.md"]},
		"build:watch": {"cache": false, "persistent": true},
		"type:check": {"dependsOn": ["^type:check"], "outputs": []},
		"test": {"outputs": ["coverage/**"]},
		"lint:package": {"dependsOn": ["build"], "outputs": []}
	}
}
